{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Football Studio Task",
  "type": "object",
  "required": [
    "task_id",
    "title",
    "status",
    "priority",
    "assigned_agent",
    "assigned_model_tier",
    "objective",
    "phase",
    "dependencies",
    "required_inputs",
    "allowed_read_paths",
    "allowed_write_paths",
    "forbidden_actions",
    "required_tools",
    "required_skills",
    "validation_commands",
    "review_required",
    "reviewer",
    "done_when",
    "block_conditions"
  ],
  "properties": {
    "task_id": {"type":"string","pattern":"^[A-Z]+-[0-9]{3,}$"},
    "title": {"type":"string","minLength":3},
    "status": {"enum":["PROPOSED","APPROVED","READY","CLAIMED","RUNNING","REVIEW","VALIDATION","BLOCKED","FAILED","DONE","CANCELLED","SUPERSEDED"]},
    "priority": {"enum":["P0","P1","P2","P3"]},
    "assigned_agent": {"enum":["codex","claude","human","unassigned"]},
    "assigned_model_tier": {"enum":["A","B","C","AUTO"]},
    "objective": {"type":"string","minLength":5},
    "phase": {"type":"string"},
    "dependencies": {"type":"array","items":{"type":"string"}},
    "required_inputs": {"type":"array","items":{"type":"string"}},
    "allowed_read_paths": {"type":"array","items":{"type":"string"}},
    "allowed_write_paths": {"type":"array","items":{"type":"string"}},
    "forbidden_actions": {"type":"array","items":{"type":"string"}},
    "required_tools": {"type":"array","items":{"type":"string"}},
    "required_skills": {"type":"array","items":{"type":"string"}},
    "validation_commands": {"type":"array","items":{"type":"string"}},
    "review_required": {"type":"boolean"},
    "reviewer": {"enum":["codex","claude","human","none"]},
    "done_when": {"type":"array","items":{"type":"string"},"minItems":1},
    "block_conditions": {"type":"array","items":{"type":"string"}},
    "claim": {
      "type":"object",
      "properties":{
        "claimed_by":{"type":"string"},
        "claimed_at":{"type":"string"},
        "base_branch":{"type":"string"},
        "work_branch":{"type":"string"}
      },
      "additionalProperties": false
    },
    "notes":{"type":"string"}
  },
  "additionalProperties": false
}